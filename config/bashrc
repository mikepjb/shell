# -*- mode: sh; -*-
# Bash configuration
# ------------------------------------------

# Mac OS likes to think bash is going out of fashion.
export BASH_SILENCE_DEPRECATION_WARNING=1
[ -t 0 ] && stty -ixon # disable C-s C-q slow/regular print keybinds, only when in a terminal

export PAGER='less -S' # instead of wrapping long/wide output, explore with less
export NPM_CONFIG_PREFIX=$HOME/.npm
export XDG_CONFIG_HOME=$HOME/.config
export HISTSIZE=50000
export HISTFILESIZE=50000
export HISTCONTROL=ignoreboth
export CDPATH=.:$HOME/src

if [ -n "$INSIDE_EMACS" ]; then
    export EDITOR='emacsclient'
else
    export EDITOR='nvim'
fi

shopt -s histappend

path_collection=(
    "$HOME/src/llama.cpp/build/bin" # llama.cpp built from source
    "$HOME/.local/bin" # User bin dir
    "/opt/homebrew/bin" # Mac OS Homebrew package manager
    "usr/local/go/bin"
    "$HOME/go/bin"
    "$HOME/.deno/bin"
    "$HOME/.npm/bin"
    "/bin"
    "/sbin" # Mac OS puts some binaries in here like `lsof`
    "/usr/local/bin"
    "/usr/bin"
    "/usr/local/sbin"
    "$HOME/.cargo/bin" # Rust!
)

join_array() { local IFS=':'; printf '%s' "$*"; }
export PATH="$(join_array "${path_collection[@]}")"

eval "$(fnm env --use-on-cd --shell bash)"

alias vi='nvim'
alias e='emacsclient -n'
alias t='task'
alias te='task export | jq '\''sort_by(.uuid) | map(del(.id, .urgency))'\'' > ~/.notes/tasks.json'
alias ti='task import ~/.notes/tasks.json'
alias c='consult'
alias x='tmux attach -t x || tmux new -s x'
alias k='kubectl'
alias kc='kubectl config current-context'
alias ks='kubectl config use-context $(k config get-contexts -o "name" | selecta)'
alias reload='source ~/.local/bin/reload'
alias cup='git -C ~/src/shell up && git -C ~/.notes up' # config up
alias gc='ctags -R .' # generate ctags
alias gr='cd $(git rev-parse --show-toplevel || echo \".\")'
alias gn='cd ~/.notes'
alias nr='npm run'
alias pr='pnpm run'
alias dt='deno task'
alias dr='deno run -A'
alias cljx='clj -M:repl:dev'
alias scrape='wget -p -k -E -H'
alias tree='tree -I node_modules -I ./target -I ./dist'
# alias t='tree | less'
alias tt='test-this'
# alias ks='kill -9 $(lsof -ti:8080)'
alias gp='gh pr create --fill'
alias gd='gh pr create --draft --fill'
alias gw='gh pr view --web'
alias cup='git -C ~/src/shell/ up && git -C ~/.notes up' # 'config up'
[[ $(command -v xdg-open) ]] && alias open=xdg-open

AIENV_DIR=~/src/shell/agent

ai-home-volume() {
    local project_dir="${1:-$PWD}"
    local canonical_dir
    local project_key

    canonical_dir=$(cd "$project_dir" 2>/dev/null && pwd -P) || {
        echo "Cannot resolve project directory: $project_dir" >&2
        return 1
    }

    if command -v sha256sum >/dev/null 2>&1; then
        project_key=$(printf '%s' "$canonical_dir" | sha256sum | awk '{print substr($1, 1, 16)}')
    elif command -v shasum >/dev/null 2>&1; then
        project_key=$(printf '%s' "$canonical_dir" | shasum -a 256 | awk '{print substr($1, 1, 16)}')
    else
        echo "Cannot find a SHA-256 utility (sha256sum or shasum)" >&2
        return 1
    fi
    printf 'agent-home-%s\n' "$project_key"
}

ai-ensure-home-volume() {
    local project_dir="${1:-$PWD}"
    local home_volume
    home_volume=$(ai-home-volume "$project_dir") || return 1

    docker volume inspect "$home_volume" >/dev/null 2>&1 ||
        docker volume create "$home_volume" >/dev/null || return 1
    printf '%s\n' "$home_volume"
}

ai-env() {
    (
        cd "$AIENV_DIR" &&
        docker compose up -d proxy
    )
}

o() {
    local project_dir="$PWD"
    local home_volume
    home_volume=$(ai-ensure-home-volume "$project_dir") || return 1

    (
        cd "$AIENV_DIR" &&
        AGENT_HOME_VOLUME="$home_volume" \
        docker compose run --rm \
            --volume "$project_dir:/workspace:rw" \
            worker codex \
            --sandbox danger-full-access \
            --ask-for-approval never \
            "$@"
    )
}

p() {
    local project_dir="$PWD"
    local home_volume
    home_volume=$(ai-ensure-home-volume "$project_dir") || return 1

    (
        cd "$AIENV_DIR" &&
        AGENT_HOME_VOLUME="$home_volume" \
        docker compose run --rm \
            --volume "$project_dir:/workspace:rw" \
            worker pi "$@"
    )
}

ai-build() {
    (
        cd "$AIENV_DIR" &&
        docker compose build proxy worker
    )
}

vc() {
    [[ -f "$1" ]] || { echo "File not found: $1"; return 1; }
    sed 's/,,/, ,/g; s/,,/, ,/g; s/,,/, ,/g' "$1" | column -s, -t | less -S
}
viw() { vim $(which "$1"); }

encrypt() {
  tar czf - "$1" | openssl enc -aes-256-cbc -salt -out "${1}.tar.gz.enc"
}

hiccup() {
  bb -d hickory -i "(import '[hickory.core :refer [parse as-hiccup]]) (-> *input* doall first parse as-hiccup println)"
}

[[ -f $HOME/.bashrc.local ]] && . $HOME/.bashrc.local

if [[ -f "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
    source "$HOME/.sdkman/bin/sdkman-init.sh"
fi

jobs_signal() { [[ $(jobs) != "" ]] && echo -e "\x01\033[0;36m\x02\$\x01\033[0m\x02" || echo -e "\$"; }
PS1='\W($(git branch --show-current 2>/dev/null || echo "!")) $(jobs_signal) '
