" Vim Configuration

set nocompatible " Disable VI Compatibility
syntax on
packadd! matchit
filetype plugin indent on

set autoindent
set autoread
set backspace=indent,eol,start
set formatoptions-=t              " Don't add line-breaks for lines over 'textwidth' chars
set hlsearch incsearch ignorecase " highlight matches live + ignore case matching
set nonumber
set nostartofline nowrap
set showmatch gdefault            " gdefault replaces all matches, not just the first
set textwidth=80 colorcolumn=+1   " 80 column width + highlight
set fillchars=vert:│,fold:\ 
set belloff=all
set clipboard=unnamed,unnamedplus
set nowritebackup noswapfile      " no temporary files please, git covers saves
set laststatus=2
set tabstop=2 softtabstop=2 shiftwidth=2 expandtab " 2-width, prefer spaces > tab
set statusline=%<%f%*\ (%{&ft})\ %-4(%m%)%=%-19(%3l,%02c%03V%)
let &l:errorformat = '%f:%l:%c:\ %m,%f:%l:\ %m,%-G%.%#'
let [g:omni_sql_no_default_maps, g:sh_noisk] = [1, 1] " prevent remaps
let g:markdown_fenced_languages=['bash=sh', 'css', 'html', 'go', 'ruby', 'sql', 'yaml', 'java']

set undodir=/tmp/.vim-undo-dir undofile
if !isdirectory(&undodir)
  call mkdir(&undodir, "", 0700)
endif

if executable('rg') " N.B ripgrep searches all files by default
  set grepprg=rg\ --vimgrep\ --smart-case\ $*
  set grepformat=%f:%l:%c:%m,%f:%l:%m
endif

colorscheme flow

command! -nargs=+ -complete=file Grep silent grep! <args> | redraw!

nnoremap Y y$
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-h> <C-w>h
nnoremap <C-l> <C-w>l
inoremap <C-l> <space>=><space>
inoremap <C-c> <esc>
nnoremap S <C-^>
nnoremap <C-q> :q<CR>
nnoremap <C-g> :noh<CR>:redraw!<CR><C-g>
nnoremap gd <C-]>
nnoremap gi :e ~/.vimrc<CR>
nnoremap gn :e ~/.notes/index.md<CR>
nnoremap ge :e <C-R>=fnamemodify(resolve(expand('%:p')), ':h') . '/'<CR>
nnoremap gs :Grep<space>
nnoremap gt /\CTODO\\|NEXT\\|CURRENT\\|DONE<CR>
nnoremap gc :!ctags -R .<CR>
nnoremap gr :read !snip<space>
nnoremap gR :Eval (user/restart)<CR>
nnoremap g<space> :cd %:h \| pwd<CR>
nnoremap gp :call Format()<CR>
nnoremap <expr> gl empty(filter(getwininfo(), 'v:val.quickfix')) ? ':copen<CR>' : ':cclose<CR>'
nnoremap Q @q
nnoremap <A-n> :cnext<CR>
nnoremap <A-p> :cprevious<CR>
cnoremap        <C-A> <Home>
cnoremap        <C-B> <Left>
cnoremap <expr> <C-D> getcmdpos()>strlen(getcmdline())?"\<Lt>C-D>":"\<Lt>Del>"
cnoremap <expr> <C-F> getcmdpos()>strlen(getcmdline())?&cedit:"\<Lt>Right>"
nnoremap Z :echo map(synstack(line('.'), col('.')), 'synIDattr(v:val, "name")')<CR>
nnoremap <C-t> :!go test ./...<cr>
nnoremap <A-t> :cexpr system('test-this ' . expand('%'))<cr>
nnoremap <A-T> :cexpr system('test-this')<cr>
nnoremap <A-r> :cexpr system('lint-this "' . expand('%') . '"')<cr>
nnoremap <A-R> :cexpr system('lint-this "' . expand('%') . '" --fix')<cr>

augroup base
  autocmd!
  autocmd QuickFixCmdPost [^l]* nested cwindow
  autocmd FileType markdown setlocal formatoptions+=t " wrap lines in .md
  autocmd FileType go,java,rust,sh setl ts=4 sw=4 sts=4
  autocmd FileType qf setlocal statusline=Quickfix\ [%{len(getqflist())}]
augroup END

function! Selecta(cmd)
  try
    let file = trim(system(a:cmd . ' | selecta'))
    redraw!
    if !empty(file) | execute 'edit' fnameescape(file) | endif
  catch /Vim:Interrupt/ | redraw! | endtry
endfunction

nnoremap <space> :call Selecta("fd -E '*_templ.go' -t f . .")<CR>
nnoremap <A-o> :call Selecta("fd -t f . ~/.notes/")<CR>

function! Format()
  update
  let out = system('format-this ' . shellescape(expand('%')))
  if v:shell_error | echoerr out | else | checktime | redraw! | endif
endfunction

nnoremap gp :call Format()<CR>

function! s:MarkdownFold() abort
  let line = getline(v:lnum)
  let level = strlen(matchstr(
        \ line,
        \ '^\s\{0,3}\zs#\{1,6}\ze\%(\s\|$\)'))

  if level == 1
    " Level-one headings are section boundaries, not folds.
    return 0
  elseif level > 1
    return '>' . (level - 1)
  endif

  if line =~# '^-\s\+\%(CURRENT\|NEXT\|TODO\|WAITING\)\>'
    for lnum in range(v:lnum - 1, 1, -1)
      let heading = strlen(matchstr(
            \ getline(lnum),
            \ '^\s\{0,3}\zs#\{1,6}\ze\%(\s\|$\)'))
      if heading
        return '>' . heading
      endif
    endfor
    return '>1'
  endif

  return '='
endfunction

function! s:MarkdownFoldFormat()
  return getline(v:foldstart) . ' '
endfunction

augroup markdown_folding
  autocmd!
  autocmd FileType markdown setlocal foldmethod=expr
  autocmd FileType markdown setlocal foldexpr=<SID>MarkdownFold()
  autocmd FileType markdown setlocal foldtext=<SID>MarkdownFoldFormat()
  autocmd FileType markdown setlocal foldlevel=0
  autocmd FileType markdown nnoremap <buffer> <C-d> za
augroup END

let s:states = ['CURRENT', 'NEXT', 'TODO', 'WAITING']

function! s:CompareTasks(a, b) abort
  return index(s:states, matchstr(a:a.text, '\C\<\w\+\>'))
        \ - index(s:states, matchstr(a:b.text, '\C\<\w\+\>'))
endfunction

function! Actions() abort
  let results = systemlist(
        \ 'rg --vimgrep --glob "*.md" --glob "!archive.md" '
        \ . shellescape('^\s*-\s+(CURRENT|NEXT|TODO|WAITING)\b')
        \ . ' ' . shellescape(expand('~/.notes')))

  if empty(results) | echo 'No actions' | return | endif

  call setqflist([], 'r', {'lines': results, 'efm': '%f:%l:%c:%m'})
  let items = getqflist()
  call sort(items, function('s:CompareTasks'))
  call setqflist(items, 'r')
  copen
endfunction

nnoremap <C-u> :call Actions()<CR>

function! QuickfixText(info) abort
  let items = getqflist({'id': a:info.id, 'items': 1}).items
  let lines = []

  for idx in range(a:info.start_idx - 1, a:info.end_idx - 1)
    let item = items[idx]
    let path = pathshorten(fnamemodify(bufname(item.bufnr), ':.'))
    call add(lines, printf('%-24.24s │ %s',
          \ path . ':' . item.lnum, item.text))
  endfor

  return lines
endfunction

set quickfixtextfunc=QuickfixText
