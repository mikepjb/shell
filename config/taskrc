# vim: ft=conf

# [Created by task 3.5.0 8/17/2026 13:39:08]
data.location=~/.task
news.version=3.5.0

report.next.labels=id,description,project,sch,due
report.next.columns=id,description,project,scheduled,due
report.next.dateformat=a D b

# ---------------------------------------------------------------------------
# Custom reports
# ---------------------------------------------------------------------------

# All pending tasks, grouped by project.
report.g.description=Pending tasks grouped by project
report.g.labels=id,description,project,sch,due
report.g.columns=id,description,project,scheduled,due
# report.g.columns=id,project,tags,scheduled.relative,due.relative,description,urgency
# report.g.labels=ID,Project,Tags,Scheduled,Due,Description,Urg
report.g.sort=project+/,urgency-
report.g.filter=status:pending

# Tasks due within the next two weeks.
report.fortnight.description=Tasks due within the next 14 days
report.fortnight.columns=id,project,tags,due.relative,description,urgency
report.fortnight.labels=ID,Project,Tags,Due,Description,Urg
report.fortnight.sort=due+,urgency-
report.fortnight.filter=status:pending due.before:2weeks

# To use the default location of the XDG directories,
# move this configuration file from ~/.taskrc to ~/.config/task/taskrc and update location config as follows:

#data.location=~/.local/share/task
#hooks.location=~/.config/task/hooks

# ---------------------------------------------------------------------------
# Colours
# ---------------------------------------------------------------------------

color=on

# State
color.active=bold green
color.overdue=bold red
color.due.today=bold yellow
color.scheduled=cyan
color.blocked=gray
color.completed=gray

# Projects
color.project.lvh=cyan
color.project.hypalynx=magenta
color.project.work=blue
color.project.self=green
color.project.home=yellow

# Tags
color.tag.docs=cyan
