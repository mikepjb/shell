#!/usr/bin/env bash
#
# With a file argument, lint that file (when supported) and run its tests.
# Without an argument, lint the project and run its test suite.

file=${1:-}
filetype=
tool=
lint_status=0
test_status=0
lint_ran=0
test_ran=0

report_result() {
    local label=$1 ran=$2 status=$3

    if (( ! ran )); then
        printf '⏭️  %s skipped\n' "$label"
    elif (( status == 0 )); then
        printf '✅ %s passed\n' "$label"
    else
        printf '❌ %s failed (exit %d)\n' "$label" "$status"
    fi
}

run_lint() {
    local linter=$1 status=0
    shift

    if ! command -v "$linter" >/dev/null 2>&1; then
        printf '⏭️  %s skipped (not installed)\n' "$linter"
        return 0
    fi

    lint_ran=1
    "$linter" "$@" || status=$?
    report_result "$linter" 1 "$status"

    if (( lint_status == 0 )); then
        lint_status=$status
    fi
}

run_test() {
    test_ran=1
    "$@" || test_status=$?
}

has_make_target() {
    local status=0

    [[ -f Makefile ]] || return 1
    make -q "$1" >/dev/null 2>&1 || status=$?
    (( status == 0 || status == 1 ))
}

if [[ -n $file ]]; then
    if [[ ! -f $file ]]; then
        printf 'File not found: %s\n' "$file" >&2
        exit 1
    fi

    case $file in
        *.sh|*.bash) filetype=shell ;;
        *.py) filetype=python ;;
        *.js|*.jsx|*.ts|*.tsx) filetype=javascript ;;
        *.go) filetype=go ;;
        *.zig) filetype=zig ;;
        *)
            IFS= read -r shebang < "$file" || :
            case $shebang in
                '#!'*bash*|'#!'*/sh*|'#!'*' sh'*) filetype=shell ;;
                '#!'*python*) filetype=python ;;
            esac
            ;;
    esac

    case $filetype in
        shell) tool=shellcheck; args=(-- "$file") ;;
        python) tool=ruff; args=(check -- "$file") ;;
        javascript) tool=eslint; args=(-- "$file") ;;
        go) tool=golangci-lint; args=(run "$(dirname "$file")/...") ;;
    esac

    if [[ -n $tool ]]; then
        run_lint "$tool" "${args[@]}"
    fi
elif has_make_target lint; then
    run_lint make lint
else
    if [[ -f pyproject.toml || -f ruff.toml || -f .ruff.toml ]]; then
        run_lint ruff check .
    fi

    if (
        shopt -s nullglob
        configs=(eslint.config.* .eslintrc .eslintrc.*)
        (( ${#configs[@]} > 0 ))
    ); then
        run_lint eslint .
    fi

    if [[ -f go.mod ]]; then
        run_lint golangci-lint run ./...
    fi
fi

if [[ -f mvnw ]]; then
    if [[ -z $file ]]; then
        run_test ./mvnw test
    else
        printf 'Single-file Maven tests are not configured\n'
    fi
elif [[ -f build.zig ]]; then
    if [[ -z $file ]]; then
        run_test zig build test
    else
        run_test zig test "$file"
    fi
elif [[ -f gradlew ]]; then
    if [[ -z $file ]]; then
        run_test ./gradlew test --info
    else
        run_test ./gradlew test --tests="$file" --info
    fi
elif [[ -f go.mod ]]; then
    if [[ -z $file ]]; then
        run_test go test ./...
    else
        run_test go test "$(dirname "$file")/..."
    fi
elif has_make_target test; then
    run_test make test
fi

printf '\n'
report_result Lint "$lint_ran" "$lint_status"
report_result Tests "$test_ran" "$test_status"

if (( lint_status != 0 )); then
    exit "$lint_status"
fi
exit "$test_status"
