#!/usr/bin/env bash
#
# Given a file, opens it in an interactive interpreter/REPL.

if [[ -z $1 ]]; then
    echo 'no file provided, exiting..'
    exit 1
fi

file=$1

if [[ -n $1 ]]; then
    if [[ ! -f $1 ]]; then
        printf 'File not found: %s\n' "$1" >&2
        exit 1
    fi

    case $1 in
        *.sh|*.bash) filetype=shell ;;
        *.py) filetype=python ;;
        *.js|*.jsx|*.ts|*.tsx) filetype=javascript ;;
        *.go) filetype=go ;;
        *)
            IFS= read -r shebang < "$1" || :
            case $shebang in
                '#!'*bash*|'#!'*/sh*|'#!'*' sh'*) filetype=shell ;;
                '#!'*python*) filetype=python ;;
            esac
            ;;
    esac

    case $filetype in
        python)
            tool=python3
            directory=$(dirname -- "$file")
            module=$(basename -- "$file" .py)
            args=(-i -c "import $module")
            ;;
    esac
    if [[ -n $tool ]]; then
        if command -v "$tool" >/dev/null 2>&1; then
            "$tool" "${args[@]}" || lint_status=$?
        else
            printf '%s not installed; unable to run %s\n' "$tool" "$1" >&2
        fi
    fi
fi
