#!/usr/bin/env python3

import json
import subprocess
from datetime import datetime, timezone


def ics_escape(value):
    """Escape text according to iCalendar rules."""
    return (
        str(value)
        .replace("\\", "\\\\")
        .replace("\n", "\\n")
        .replace(";", "\\;")
        .replace(",", "\\,")
    )


def taskwarrior():
    result = subprocess.run(
        ["task", "status:pending", "scheduled.any:", "export"],
        capture_output=True,
        text=True,
        check=True,
    )
    return json.loads(result.stdout)


def categories(task):
    values = []

    if task.get("project"):
        values.append(task["project"])

    values.extend(task.get("tags", []))

    return values


tasks = taskwarrior()

print("BEGIN:VCALENDAR")
print("VERSION:2.0")
print("PRODID:-//Taskwarrior//Scheduled Tasks//EN")
print("CALSCALE:GREGORIAN")
print("METHOD:PUBLISH")

now = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")

for task in tasks:
    scheduled = task.get("scheduled")

    if not scheduled:
        continue

    print("BEGIN:VEVENT")
    print(f"UID:{task['uuid']}@taskwarrior")
    print(f"DTSTAMP:{now}")
    print(f"DTSTART:{scheduled}")
    print(f"SUMMARY:{ics_escape(task['description'])}")

    cats = categories(task)
    if cats:
        print("CATEGORIES:" + ",".join(ics_escape(x) for x in cats))

    annotations = task.get("annotations", [])
    if annotations:
        description = "\n".join(
            annotation["description"]
            for annotation in annotations
        )
        print(f"DESCRIPTION:{ics_escape(description)}")

    print("END:VEVENT")

print("END:VCALENDAR")
