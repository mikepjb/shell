#!/usr/bin/env python3
"""A small inline fuzzy selector. Candidates come from stdin; UI uses /dev/tty."""

import argparse
import codecs
import os
import select
import sys
import termios
import tty
import unicodedata


VERSION = "0.1.0"


def read_choices():
    return [line.strip() for line in sys.stdin if line.strip()]


def is_boundary(character):
    return not (character.isascii() and (character.isalnum() or character == "_"))


def score_from(text, query, first):
    """Match greedily after first; return (score, last index), or None."""
    last = first
    score = 1
    last_type = None

    for character in query[1:]:
        found = text.find(character, last + 1)
        if found == -1:
            return None
        if found == last + 1:
            if last_type != "sequential":
                score += 1
            last_type = "sequential"
        elif is_boundary(text[found - 1]):
            if last_type != "boundary":
                score += 1
            last_type = "boundary"
        else:
            score += found - last
            last_type = "normal"
        last = found

    return score, last


def find_match(text, query):
    """Return (score, first, last) for the best match, or None.

    Both arguments must already be lowercase. A blank query is handled by rank.
    """
    if not query:
        return None
    best = None
    search_from = 0
    while True:
        first = text.find(query[0], search_from)
        if first == -1:
            break
        result = score_from(text, query, first)
        if result is not None:
            score, last = result
            if best is None or score < best[0]:
                best = (score, first, last)
        search_from = first + 1
    return best


def rank(choices, query, lowered=None):
    """Return (choice index, first, last) ordered like Selecta."""
    if not query:
        return [(index, None, None) for index in range(len(choices))]
    if lowered is None:
        lowered = [choice.lower() for choice in choices]
    query = query.lower()
    matches = []
    for index, text in enumerate(lowered):
        result = find_match(text, query)
        if result is None:
            continue
        score, first, last = result
        key = (score, last - first + 1, len(choices[index]), index)
        matches.append((key, (index, first, last)))
    return [match for _, match in sorted(matches)]


def display_char(character):
    """Make control characters harmless on the terminal."""
    if not character.isprintable():
        return "?"
    return character


def char_width(character):
    if unicodedata.combining(character):
        return 0
    return 2 if unicodedata.east_asian_width(character) in ("W", "F") else 1


def display(text, width, start=None, end=None):
    """Clip without wrapping, retaining optional match highlighting."""
    parts = []
    used = 0
    highlighting = False
    for index, character in enumerate(text):
        safe = display_char(character)
        size = char_width(safe)
        if used + size > width:
            break
        matched = start is not None and start <= index <= end
        if matched != highlighting:
            parts.append("\x1b[34m" if matched else "\x1b[39m")
            highlighting = matched
        parts.append(safe)
        used += size
    if highlighting:
        parts.append("\x1b[39m")
    return "".join(parts), used


def write(terminal, text):
    terminal.write(text.encode("utf-8", errors="replace"))


def render(terminal, choices, matches, query, cursor, slots):
    width = max(1, os.get_terminal_size(terminal.fileno()).columns - 1)
    prompt = f"{len(matches):>{len(str(len(choices)))}} > {query}"
    prompt, prompt_width = display(prompt, width)
    lines = [prompt]
    for slot in range(slots):
        if slot < len(matches):
            index, start, end = matches[slot]
            line, _ = display(choices[index], width, start, end)
            if slot == cursor:
                line = "\x1b[7m" + line + "\x1b[0m"
            lines.append(line)
        else:
            lines.append("")
    for index, line in enumerate(lines):
        write(terminal, "\r\x1b[2K" + line)
        if index < slots:
            write(terminal, "\r\n")
    if slots:
        write(terminal, f"\x1b[{slots}A")
    write(terminal, "\r" + (f"\x1b[{prompt_width}C" if prompt_width else ""))


def read_key(fd, decoder):
    """Read a key; ESC sequences have a short timeout so ESC alone won't hang."""
    first = os.read(fd, 1)
    if first == b"\x1b":
        if not select.select([fd], [], [], 0.05)[0]:
            return "escape"
        second = os.read(fd, 1)
        if second not in (b"[", b"O"):
            return "escape"
        if not select.select([fd], [], [], 0.05)[0]:
            return "escape"
        third = os.read(fd, 1)
        return {b"A": "up", b"B": "down"}.get(third, "escape")
    if not first:
        return "eof"
    control = {
        b"\x0d": "enter", b"\x0a": "enter", b"\x7f": "backspace",
        b"\x08": "backspace", b"\x0e": "down", b"\x10": "up",
        b"\x15": "clear", b"\x17": "word", b"\x04": "eof",
    }
    if first in control:
        decoder.reset()
        return control[first]
    if first[0] < 32:
        decoder.reset()
        return "ignore"
    try:
        character = decoder.decode(first)
    except UnicodeDecodeError:
        decoder.reset()
        return "ignore"
    return ("text", character) if character.isprintable() else "ignore"


def delete_word(query):
    # Match Selecta's Ctrl-W: remove trailing spaces and the preceding word.
    query = query.rstrip(" ")
    while query and query[-1] != " ":
        query = query[:-1]
    return query


def run(terminal, choices, initial_query, requested_height):
    fd = terminal.fileno()
    old_settings = termios.tcgetattr(fd)
    decoder = codecs.getincrementaldecoder("utf-8")()
    lowered = [choice.lower() for choice in choices]
    query = initial_query
    matches = rank(choices, query, lowered)
    cursor = 0
    size = os.get_terminal_size(fd)
    height = size.lines if requested_height == "full" else int(requested_height)
    slots = max(0, min(height, size.lines) - 1)
    chosen = None
    try:
        tty.setcbreak(fd)
        if slots:
            write(terminal, "\r\n" * slots + f"\x1b[{slots}A\r")
        while True:
            cursor = min(cursor, max(0, min(len(matches), slots) - 1))
            render(terminal, choices, matches, query, cursor, slots)
            key = read_key(fd, decoder)
            if key == "enter":
                if matches:
                    chosen = choices[matches[cursor][0]]
                break
            if key == "eof":
                break
            if key == "down" and matches and slots:
                cursor = (cursor + 1) % min(len(matches), slots)
            elif key == "up" and matches and slots:
                cursor = (cursor - 1) % min(len(matches), slots)
            elif key == "backspace":
                query = query[:-1]
                matches = rank(choices, query, lowered)
                cursor = 0
            elif key == "clear":
                query = ""
                matches = rank(choices, query, lowered)
                cursor = 0
            elif key == "word":
                query = delete_word(query)
                matches = rank(choices, query, lowered)
                cursor = 0
            elif isinstance(key, tuple) and key[0] == "text" and key[1]:
                query += key[1]
                matches = rank(choices, query, lowered)
                cursor = 0
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        write(terminal, f"\x1b[{slots}B\r\n" if slots else "\r\n")
    return chosen


def parse_args(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-s", "--search", default="", help="initial query")
    parser.add_argument("--height", default="18", help="UI height (at least 2) or full")
    parser.add_argument("--version", action="version", version=VERSION)
    args = parser.parse_args(argv)
    if args.height != "full" and (not args.height.isdecimal() or int(args.height) < 2):
        parser.error("--height must be at least 2 or 'full'")
    return args


def main(argv=None):
    args = parse_args(argv)
    choices = read_choices()
    try:
        with open("/dev/tty", "r+b", buffering=0) as terminal:
            choice = run(terminal, choices, args.search, args.height)
    except (OSError, termios.error) as error:
        print(f"spear: terminal unavailable: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    if choice is not None:
        print(choice)
    return 0


if __name__ == "__main__":
    sys.exit(main())
