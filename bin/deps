#!/usr/bin/env bash
# This script just makes sure the deps are available and does not update
# them. For that use `sudo pacman -Syu` or `brew upgrade`.
#
# TODO util-linux is weird, linux has it, mac os has an alternative set of cli
# utils with the same names so my current script doesn't work for this..

declare -A -r PACKAGES=(
    # ['k3d']='rancher-k3d-bin k3d' # requires AUR
    ['curl']=''
    ['git']=''
    ['gopls']=''
    ['glow']=''
    ['hf']='huggingface-cli python-huggingface-hub'
    ['kubectl']=''
    ['make']=''
    ['nvim']='neovim'
    ['vim']='gvim vim'
    ['pip']=''
    ['pipx']=''
    ['python']=''
    ['zig']=''
    ['rg']='ripgrep'
    ['fd']='fd'
    ['shellcheck']=''
    ['taskwarrior-tui']=''
    ['tmux']=''
    ['wget']=''
    ['yq']='go-yq yq'
    ['docker']=''
    ['docker-compose']=''
    ['cwebp']='libwebp-utils'
    ['clojure']=''
    ['lynx']=''
)

OS="$(uname)"
to_install=""

for key in "${!PACKAGES[@]}"; do
    if command -v "$key" >/dev/null 2>&1; then
        echo "✔  $key is already installed. Skipping..."
        continue
    fi

    val="${PACKAGES[$key]}"
    pkg_to_add=""

    if [[ -z "$val" ]]; then
        pkg_to_add="$key"
    else
        read -r -a parts <<< "$val"
        if [[ ${#parts[@]} -eq 1 ]]; then
            pkg_to_add="${parts[0]}"
        else
            if [[ "$OS" == "Linux" ]]; then
                pkg_to_add="${parts[0]}"
            else
                pkg_to_add="${parts[1]}"
            fi
        fi
    fi

    echo "+ $key not found. Adding '$pkg_to_add' to install list."
    to_install="$to_install $pkg_to_add"
done

# Trim whitespace
to_install=$(echo "$to_install" | xargs)

echo "--------------------------"

if [[ -z "$to_install" ]]; then
    echo "All dependencies are already satisfied."
else
    echo "Final install list: $to_install"

    if [[ "$OS" == "Linux" ]]; then
        sudo pacman -S --needed $to_install
    else
        brew install $to_install
    fi
fi

if command -v pipx >/dev/null 2>&1; then
    if pipx list --short | awk '$1 == "toml-cli" { found = 1 } END { exit !found }'; then
        echo "toml-cli is already installed with pipx. Skipping..."
    else
        pipx install toml-cli
    fi
else
    echo "pipx is required to install toml-cli; install pipx and rerun deps." >&2
fi

pi_package() {
    local source="$1"

    if ! command -v pi >/dev/null 2>&1; then
        echo "pi is required to install $source; install Pi and rerun deps." >&2
        return 1
    fi

    if pi list --no-approve | grep -Fq -- "$source"; then
        echo "$source is already installed with Pi. Skipping..."
    else
        echo "Installing Pi package $source..."
        pi install "$source"
    fi
}

pi_package "npm:pi-web-search"

echo "--------------------------"

emacs_base="$HOME/.emacs.d/external"

# need to download paredit at least

elisp_base="$HOME/.emacs.d/lisp"

mkdir -p $elisp_base

elisp() {
    local repo="$1"
    local filepath="$2"
    local branch="${3:-main}"
    local raw_domain="https://raw.githubusercontent.com"

    if [[ ! -f "$elisp_base/$filepath" ]]; then
	curl -L -o "$elisp_base/$filepath" \
	     "$raw_domain/$repo/refs/heads/$branch/$filepath"
    else
	echo "$filepath already exists in $elisp_base. Skipping."
    fi
}

elisp "clojure-emacs/clojure-mode" "clojure-mode.el" "master"
elisp "emacsmirror/paredit" "paredit.el" "master"
elisp "dominikh/go-mode.el" "go-mode.el" "master"

# TODO
# markdown-mode
# json-mode?
# js2-mode?
# web-mode?
# olivetti? nah not spartan.

echo "--------------------------"

pkg_base="$HOME/.vim/pack/base"
local_bin="$HOME/.local/bin"


plugin() {
    local slug="$1"
    local sub_dir="${2:-start}"
    local repo_name="${slug#*/}"
    local target_dir="$pkg_base/$sub_dir/$repo_name"

    if [[ ! -d "$target_dir" ]]; then
        echo "Cloning $slug into $sub_dir..."
        git clone "https://github.com/$slug.git" "$target_dir" --depth=1
    else
        echo "$repo_name already exists in $sub_dir. Skipping."
    fi
}

mkdir -p $pkg_base/start $pkg_base/opt

echo 'Ensuring vim plugins and selecta are available'

plugin "tpope/vim-fugitive"
plugin "godlygeek/tabular"

if [[ ! -f $local_bin/selecta ]]; then
  curl -L -o "$local_bin/selecta" \
    https://github.com/garybernhardt/selecta/raw/refs/heads/master/selecta
  chmod +x "$local_bin/selecta"
fi

mkdir -p "$HOME/.local/src"

if [[ ! -d "$HOME/.local/src/node" ]]; then
    git clone https://github.com/nodejs/node.git \
        "$HOME/.local/src/node" --depth=1
fi

mdn_dir="$HOME/.local/src/mdn-content"
if [[ ! -d "$mdn_dir" ]]; then
    git clone --depth=1 --filter=blob:none --sparse https://github.com/mdn/content.git "$mdn_dir" || exit 1
fi
git -C "$mdn_dir" sparse-checkout set files/en-us/web/javascript files/en-us/web/api || exit 1

mkdir -p "$HOME/.local/jars"

if [[ ! -f "$HOME/.local/jars/cfr.jar" ]]; then
    echo "Downloading latest CFR Java Decompiler..."
    curl -s https://api.github.com/repos/leibnitz27/cfr/releases/latest \
        | grep "browser_download_url" \
        | grep -vE "(-sources|-javadoc)\.jar" \
        | cut -d '"' -f 4 \
        | xargs curl -L -o "$HOME/.local/jars/cfr.jar"
    
    echo "✔ CFR downloaded and saved to ~/.local/jars/cfr.jar"
fi
