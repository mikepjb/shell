#!/usr/bin/env bash

script_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
shell_repo_root=$(realpath "$script_dir/..")
sconf="$shell_repo_root/config"
local_bin_dir="$HOME/.local/bin"

section() {
    printf '\033[34m%s\033[0m\n' "$1"
}

# ------------------------------------------------------------------------------
section 'Symlinking agent configuration'

# Link only managed Pi config; keep auth.json, sessions, and other local state
# untouched.
mkdir -p "$HOME/.pi/agent/extensions"
mkdir -p "$HOME/.pi/agent/skills"
mkdir -p "$HOME/.pi/agent/themes"

ln -sfv "$sconf/AGENTS.md" "$HOME/.pi/agent/AGENTS.md"
ln -sfnv "$sconf/pi/settings.json" "$HOME/.pi/agent/settings.json"
ln -sfnv "$sconf/pi/keybindings.json" "$HOME/.pi/agent/keybindings.json"
ln -sfnv "$sconf/pi/presets.json" "$HOME/.pi/agent/presets.json"
ln -sfnv "$sconf/pi/extensions/presets.ts" "$HOME/.pi/agent/extensions/presets.ts"
ln -sfnv "$sconf/pi/extensions/statusline.ts" "$HOME/.pi/agent/extensions/statusline.ts"
ln -sfnv "$sconf/pi/extensions/hardware-cursor.ts" "$HOME/.pi/agent/extensions/hardware-cursor.ts"
ln -sfnv "$sconf/pi/extensions/save-history.ts" "$HOME/.pi/agent/extensions/save-history.ts"
ln -sfnv "$sconf/pi/themes/carbonfox.json" "$HOME/.pi/agent/themes/carbonfox.json"

for skill_dir in "$sconf/skills/"*/; do
    [ -d "$skill_dir" ] || continue
    skill_name=$(basename "$skill_dir")
    ln -sfnv "$skill_dir" "$HOME/.pi/agent/skills/$skill_name"
done

# ------------------------------------------------------------------------------
section 'Symlinking configurations'

mkdir -p "$local_bin_dir"

# Extensionless config files go to $HOME/.$filename
for config_file in "$sconf/"*; do
    filename=$(basename "$config_file")
    if [ -d "$config_file" ] || [[ "$filename" == *.* ]]; then
        continue # skip config with file extensions, done manually below
    fi
    ln -sfv "$config_file" "$HOME/.$filename"
done

mkdir -p "$HOME"/.config/{clojure,ghostty,ctags}
mkdir -p "$HOME"/.vim/{colors,spell}
mkdir -p "$HOME/.vim/colors"
mkdir -p "$HOME/.config/ghostty/themes"

ln -sfv "$sconf/tmux.conf" "$HOME/.config/tmux/tmux.conf"
ln -sfv "$sconf/user.edn" "$HOME/.config/clojure/deps.edn"
ln -sfv "$sconf/ghostty.conf" "$HOME/.config/ghostty/config"
ln -sfv "$sconf/vimrc" "$HOME/.vimrc"
ln -sfv "$sconf/flow-theme.el" "$HOME/.emacs.d/flow-theme.el"
ln -sfv "$sconf/ctags" "$HOME/.config/ctags/base.ctags"
ln -sfv "$sconf/flow.vim" "$HOME/.vim/colors/flow.vim"

if [[ -f "$HOME/.notes/spell.utf-8.add" ]]; then
    ln -sfv "$HOME/.notes/spell.utf-8.add" "$HOME/.vim/spell/spell.utf-8.add"
fi

# ------------------------------------------------------------------------------
section 'Symlinking scripts from ./bin'

for bin_file in "$shell_repo_root/bin/"*; do
  ln -sfv "$bin_file" "$local_bin_dir/$(basename "$bin_file")"
done

section 'Reloading all configurations'

if [[ -n "${TMUX:-}" ]]; then
    tmux source-file ~/.config/tmux/tmux.conf
fi

# ------------------------------------------------------------------------------
section 'ensuring cli tools are available'

required_tools=(
    # essentials
    vim
    make
    curl
    wget
    git

    # language specific
    pip
    pipx
    python3
    go
    node
    shellcheck

    # extras
    kubectl
    docker
    rg
    tmux
    glow # Markdown syntax highlighter
    hf # hugging face cli
    cwebp
    jq
    yq
    fd

    # lsps
    gopls
)

for tool in "${required_tools[@]}"; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf '\033[31mMissing CLI tool: %s\033[0m\n' "$tool"
    fi
done

# ------------------------------------------------------------------------------
section 'ensuring vim plugins are available'

pkg_base="$HOME/.vim/pack/base"

plugin() {
    local slug="$1"
    local sub_dir="${2:-start}"
    local repo_name="${slug#*/}"
    local target_dir="$pkg_base/$sub_dir/$repo_name"

    if [[ ! -d "$target_dir" ]]; then
        echo "cloning $slug into $sub_dir..."
        git clone "https://github.com/$slug.git" "$target_dir" --depth=1
    else
        echo "$repo_name already exists in $sub_dir. skipping."
    fi
}

plugin "tpope/vim-fugitive"
plugin "godlygeek/tabular"
