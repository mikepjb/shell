#!/usr/bin/env bash
#
# Usage: llm [qwen|gemma]
# The argument takes precedence over LLM_MODEL; Qwen is the default.
profile=${1:-${LLM_MODEL:-qwen}}

case "$profile" in
    qwen)
        model_ref="qwen35-2b"
        model_repo="unsloth/Qwen3.5-2B-GGUF"
        model_filename="Qwen3.5-2B-UD-Q5_K_XL.gguf"
        sampling_args=(
            --temp 1.0
            --top-p 1.0
            --min-p 0.0
            --top-k 20
            --repeat-penalty 1.0
            --presence-penalty 2.0
        )
        ;;
    gemma)
        model_ref="gemma-4-e4b"
        model_repo="unsloth/gemma-4-E4B-it-GGUF"
        model_filename="gemma-4-E4B-it-UD-Q5_K_XL.gguf"
        sampling_args=(
            --temp 1.0
            --top-p 0.95
            --min-p 0.0
            --top-k 64
            --repeat-penalty 1.0
            --presence-penalty 0.0
        )
        ;;
    *)
        echo "Unknown model: $profile (available: qwen, gemma)" >&2
        exit 2
        ;;
esac

model_file="$HOME/models/$model_filename"

if [ ! -f "$model_file" ]; then
    hf download \
        "$model_repo" \
        "$model_filename" \
        --local-dir "$HOME/models"
fi

args=(
    --alias "$model_ref"
    -m "$model_file"       # Path to the model file
    # --spec-type draft-mtp  # Use MTP for faster inference
    # --spec-draft-n-max 4
    --jinja                # Enables the chat-template arguments used by consult
    --host 127.0.0.1
    --port 7777
    # 129536
    -c 64768               # Context size (tokens)
    --cache-prompt         # Cache the prompt to speed up requests
    --metrics              # Show tps etc in llama-server's logs
    -ngl -1                # Offload all layers to GPU (-1)
    -np 1                  # Number of parallel slots/users
    --flash-attn on        # Enable Flash Attention for speed
    "${sampling_args[@]}"
)

echo "llama-server ${args[*]}" # print args out in case we need to debug
llama-server "${args[@]}"
