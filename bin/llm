#!/usr/bin/env bash
#
# Current primary is Qwen 3.5 2B (Q5).
#
# Quantisation:
# - Q5 > Q3, at least on 780M is only like 10-15% slower but the quality of the
# output means this is a very good trade as there is little speed up to
# compensate.

model_size="2B"
quantisation="Q4_K_M"
# model_filename="MiniCPM5-$model_size-$quantisation.gguf"
model_filename="Qwen3.5-$model_size-$quantisation.gguf"
# model_filename="gemma-4-$model_size-$quantisation.gguf"
model_file="$HOME/models/$model_filename"

if [ ! -f $model_file ]; then
    hf download \
        "unsloth/Qwen3.5-$model_size-GGUF" \
        "$model_filename" \
        --local-dir ~/models

        # "openbmb/MiniCPM5-$model_size-GGUF" \
        # "unsloth/gemma-4-$model_size-GGUF" \
        # "bartowski/MiniCPM5-$model_size-GGUF" \
fi

args=(
    -m "$model_file"       # Path to the model file
    # --spec-type draft-mtp  # Use MTP for faster inference
    # --spec-draft-n-max 4
    --jinja                # Required for Gemma 4 12B, otherwise prefer --no-jinja
    --host 127.0.0.1
    --port 7777
    # 129536
    -c 64768               # Context size (tokens)
    --cache-prompt         # Cache the prompt to speed up requests
    --metrics              # Show tps etc in llama-server's logs
    -ngl -1                # Offload all layers to GPU (-1)
    -np 1                  # Number of parallel slots/users
    --temp 1               # LLM temperature (creativity) (1 for Gemma/MiniCPM, 0.6 Qwen)
    --top-p 0.95           # Top-p sampling
    --min-p 0.0            # default is 0.05 but openbmb recommend 0 for MiniCPM5 2B
    # --top-k 20             # Top-k sampling (64 for Gemma, 20 for Qwen)
    --flash-attn on        # Enable Flash Attention for speed
    --repeat-penalty 1.0   # 1.0 == disabled
    --presence-penalty 0.0 # 0.0 == disabled
)

echo "llama-server ${args[@]}" # print args out incase we need to debug
llama-server "${args[@]}"
